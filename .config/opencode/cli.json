{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "mode": "system",
    "name": "vesper"
  },
  "animations": true,
  "mouse": true,
  "scroll": {
    "acceleration": true
  },
  "session": {
    "sidebar": "hide"
  },
  "tabs": {
    "mode": "off"
  },
  "keybinds": {
    "session.line.up": "ctrl+u,super+y,ctrl+alt+y",
    "session.line.down": "ctrl+d,super+e,ctrl+alt+e",
    "session.page.up": "ctrl+b,ctrl+alt+b",
    "session.page.down": "ctrl+f,ctrl+alt+f",
    "input.delete.to.line.start": "none",
    "input.delete": "none",
    "input.move.left": "none",
    "input.move.right": "none",
    "messages.copy": "none"
  }
}
