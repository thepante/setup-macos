{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "/Users/fabian/.config/zed/AGENTS.md"
  ],
  "permissions": [
    { "action": "shell", "resource": "git commit *", "effect": "deny" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git rebase *", "effect": "deny" },
    { "action": "shell", "resource": "git reset *", "effect": "deny" },
    { "action": "shell", "resource": "git clean *", "effect": "deny" },
    { "action": "shell", "resource": "git filter-branch *", "effect": "deny" },
    { "action": "shell", "resource": "git filter-repo *", "effect": "deny" },
    { "action": "shell", "resource": "git am *", "effect": "deny" },
    { "action": "shell", "resource": "git cherry-pick *", "effect": "deny" },
    { "action": "shell", "resource": "git merge *", "effect": "deny" },
    { "action": "shell", "resource": "git pull *", "effect": "deny" },
    { "action": "shell", "resource": "git revert *", "effect": "deny" },
    { "action": "shell", "resource": "php artisan migrate *", "effect": "deny" },
    { "action": "shell", "resource": "php artisan migrate:fresh *", "effect": "deny" },
    { "action": "shell", "resource": "php artisan migrate:refresh *", "effect": "deny" },
    { "action": "shell", "resource": "php artisan migrate:reset *", "effect": "deny" },
    { "action": "shell", "resource": "php artisan migrate:rollback *", "effect": "deny" },
    { "action": "shell", "resource": "php artisan db:wipe *", "effect": "deny" },
    { "action": "shell", "resource": "php artisan schema:dump *--prune*", "effect": "deny" },
    { "action": "shell", "resource": "./dott artisan migrate *", "effect": "deny" },
    { "action": "shell", "resource": "./dott artisan migrate:fresh *", "effect": "deny" },
    { "action": "shell", "resource": "./dott artisan migrate:refresh *", "effect": "deny" },
    { "action": "shell", "resource": "./dott artisan migrate:reset *", "effect": "deny" },
    { "action": "shell", "resource": "./dott artisan migrate:rollback *", "effect": "deny" },
    { "action": "shell", "resource": "./dott artisan db:wipe *", "effect": "deny" },
    { "action": "shell", "resource": "./dott artisan schema:dump *--prune*", "effect": "deny" },
    { "action": "shell", "resource": "./dott db:fresh *", "effect": "deny" },
    { "action": "shell", "resource": "./dott db:migrate *", "effect": "deny" },
    { "action": "shell", "resource": "./dott db:rollback *", "effect": "deny" },
    { "action": "shell", "resource": "./dott migrate:rollback *", "effect": "deny" },
    { "action": "shell", "resource": "./dott db:squash *", "effect": "deny" },
    { "action": "shell", "resource": "./dott migrate *", "effect": "deny" },
    { "action": "shell", "resource": "./dott setup *", "effect": "deny" },
    { "action": "shell", "resource": "./dott sync *", "effect": "deny" },
    { "action": "shell", "resource": "./dott server * artisan migrate *", "effect": "deny" },
    { "action": "shell", "resource": "make migrate *", "effect": "deny" },
    { "action": "shell", "resource": "go run * migrate *", "effect": "deny" },
    { "action": "shell", "resource": "rm *", "effect": "deny" },
    { "action": "shell", "resource": "git add *", "effect": "ask" },
    { "action": "shell", "resource": "git apply --cached *", "effect": "ask" },
    { "action": "shell", "resource": "git restore *", "effect": "ask" },
    { "action": "shell", "resource": "git checkout -- *", "effect": "ask" },
    { "action": "shell", "resource": "git rm *", "effect": "ask" },
    { "action": "shell", "resource": "git stage *", "effect": "ask" },
    { "action": "shell", "resource": "./dott db:sql *", "effect": "ask" },
    { "action": "shell", "resource": "./dott server * sql *", "effect": "ask" }
  ],
  "compaction": {
    "auto": true,
    "buffer": "30%",
    "keep": {
      "tokens": 15000
    }
  },
  "tool_output": {
    "max_lines": 1000,
    "max_bytes": 32000
  },
  "plugins": [
    {
      "package": "opencode-claude-memory",
      "options": {
        "readOnly": true
      }
    }
  ],
  "agents": {
    "opencode-memory-recall": {
      "model": "opencode-go/claude-haiku-5-5"
    },
    "ui-polish": {
      "description": "Session profile for UI polish and visual adjustments: same tools, a cheaper model.",
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-pro#high"
    }
  },
  "mcp": {
    "pencil": {
      "command": [
        "/Applications/Pen.app/Contents/Resources/app.asar.unpacked/out/mcp-server-darwin-arm64",
        "--app",
        "desktop",
        "--agent",
        "openCodeCLI"
      ],
      "enabled": true,
      "type": "local"
    },
    "perseus-dott": {
      "command": ["/Users/fabian/.local/bin/perseus-mcp"],
      "enabled": true,
      "type": "local"
    }
  }
}