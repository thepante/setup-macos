{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "/Users/fabian/.config/zed/AGENTS.md"
  ],
  "compaction": {
    "auto": true,
    "buffer": "30%",
    "keep": {
      "tokens": 15000
    }
  },
  "tool_output": {
    "max_lines": 1000,
    "max_bytes": 32000
  },
  "plugins": [
    {
      "package": "opencode-claude-memory",
      "options": {
        "readOnly": true
      }
    }
  ],
  "agents": {
    "opencode-memory-recall": {
      "model": "opencode-go/claude-haiku-5-5"
    },
    "ui-polish": {
      "description": "Session profile for UI polish and visual adjustments: same tools, a cheaper model.",
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-pro#high"
    }
  },
  "mcp": {
    "pencil": {
      "command": [
        "/Applications/Pen.app/Contents/Resources/app.asar.unpacked/out/mcp-server-darwin-arm64",
        "--app",
        "desktop",
        "--agent",
        "openCodeCLI"
      ],
      "enabled": true,
      "type": "local"
    },
    "perseus-dott": {
      "command": ["/Users/fabian/.local/bin/perseus-mcp"],
      "enabled": true,
      "type": "local"
    }
  }
}