  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|Read",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/fabian/.agents/skills/project-tools/bin/read-notice",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/fabian/.claude/hooks/command-guard",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/fabian/.claude/hooks/context-guard",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude --feature-session-naming=false 2>/dev/null || true'",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "/Users/fabian/.claude/hooks/rexurrect-report-claude",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "/Users/fabian/.config/rex/agent-session record claude-code",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/Users/fabian/Documents/setup-macos/.claude/statusline",
    "refreshInterval": 5
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Thinking"
    ]
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "default",
  "theme": "dark",
  "switchModelsOnFlag": true
}